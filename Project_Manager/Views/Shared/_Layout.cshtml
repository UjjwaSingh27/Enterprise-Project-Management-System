<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <<title>@ViewBag.Title - Project Manager</title>

    <!-- CSS -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link href="https://kendo.cdn.telerik.com/themes/14.1.0/meridian/meridian-main.css" rel="stylesheet" />

    <link href="~/Content/Site.css" rel="stylesheet" />
    <script src="~/Scripts/modernizr-2.8.3.js"></script>


</head>
<body>

    <!-- Page content -->
    <div class="container body-content">
        @RenderBody()
    </div>

    <!-- jQuery FIRST -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <!-- Kendo SECOND -->
    <script src="https://kendo.cdn.telerik.com/2026.2.520/js/kendo.all.min.js"></script>


    <!-- Bootstrap LAST -->
    <script src="~/Scripts/bootstrap.min.js"></script>

    <!-- Page-specific scripts -->
    @RenderSection("scripts", required: false)

</body>
</html>