@{
    ViewBag.Title = "Login";
}

<!DOCTYPE html>
<html>
<head>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <meta charset="utf-8" />
    <title>Login</title>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Segoe UI', sans-serif;
            background: #f5f7fb;
        }

        .login-container {
            display: flex;
            width: 100%;
            height: 100%;
        }

        .left-panel {
            width: 40%;
            background: linear-gradient(180deg,#6C63FF,#4F46E5);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 60px;
        }

        .logo {
            width: 70px;
            height: 70px;
            border-radius: 16px;
            background: rgba(255,255,255,.15);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 34px;
            margin-bottom: 25px;
        }

        .left-panel h1 {
            margin: 0;
            font-size: 34px;
        }

        .tagline {
            margin-top: 12px;
            opacity: .9;
            line-height: 1.6;
        }

        .left-panel h3 {
            margin-top: 50px;
            margin-bottom: 20px;
        }

        .module-item {
            background: rgba(255,255,255,.12);
            padding: 14px 18px;
            border-radius: 10px;
            margin-bottom: 15px;
            font-size: 16px;
        }

            .module-item.active {
                background: rgba(255,255,255,.22);
            }

        .right-panel {
            flex: 1;
            display: flex;
            justify-content: flex-start;
            align-items: center;
            padding-left: 90px;
        }

        .login-box {
            width: 380px;
            background: white;
            padding: 40px;
            border-radius: 18px;
            box-shadow: 0 15px 40px rgba(0,0,0,.08);
        }

            .login-box h2 {
                margin: 0;
                font-size: 30px;
            }

        .subtitle {
            color: gray;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 22px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
        }

        input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px 14px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-size: 15px;
        }

            input:focus {
                outline: none;
                border-color: #6C63FF;
            }

        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            background: #6C63FF;
            color: white;
            font-size: 16px;
            cursor: pointer;
            transition: .3s;
        }

            button:hover {
                background: #4F46E5;
            }

        .error {
            margin-top: 20px;
            color: #dc2626;
            text-align: center;
            font-weight: 600;
        }


        .feature-list {
            margin-top: 30px;
            color: rgba(255,255,255,.9);
            line-height: 2;
            font-size: 15px;
        }

        .feature-item {
            margin-bottom: 14px;
            font-size: 15px;
        }

            .feature-item i {
                margin-right: 10px;
            }

        .left-divider {
            border: none;
            height: 1px;
            background: rgba(255,255,255,.25);
            margin: 35px 0;
        }

    </style>
</head>
<body>

    <div class="login-container">

        <div class="left-panel">

            <div class="logo">
                <i class="fa-solid fa-diagram-project"></i>
            </div>

            <h1>Project Manager</h1>

            <p class="tagline">
                Enterprise Project Management System
            </p>

            <hr class="left-divider" />

            <h3>Available Modules</h3>

            <div class="module-list">

                <div class="module-item active">
                    <i class="fa-solid fa-calendar-days"></i>
                    Project Planner
                </div>
                <div class="feature-list">
                    <div class="feature-item">
                        <i class="fa-solid fa-check"></i> Manage Projects
                    </div>

                    <div class="feature-item">
                        <i class="fa-solid fa-check"></i> Track Timelines
                    </div>

                    <div class="feature-item">
                        <i class="fa-solid fa-check"></i> Monitor Progress
                    </div>
                </div>

            </div>

        </div>


        <div class="right-panel">

            <div class="login-box">

                <h2>Welcome Back</h2>

                <p class="subtitle">
                    Sign in to continue
                </p>

                @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                {
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text"
                               name="username"
                               placeholder="Enter username"
                               required />
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <input type="password"
                               name="password"
                               placeholder="Enter password"
                               required />
                    </div>

                    <button type="submit">
                        Sign In
                    </button>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="error">
                        @ViewBag.Error
                    </div>
                }

            </div>

        </div>

    </div>

</body>
</html> 